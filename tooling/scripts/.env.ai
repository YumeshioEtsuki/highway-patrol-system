# AI 助手配置

# Ollama API 配置
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen:7b

# AI 功能开关（1=启用, 0=禁用）
AI_ENABLED=1

# AI 请求超时（秒）
AI_REQUEST_TIMEOUT=30

# AI 调试日志（1=启用, 0=禁用）
AI_DEBUG_LOG=1

# 可选的其他模型：
# - qwen:7b (通义千问，适合中文)
# - llama2 (Meta 开源模型)
# - mixtral (Mistral AI 模型)
# - gemma (Google 模型)
