# 编码风格与规范

统一项目的编码规范，支持多个编辑器和 IDE。

[*.py]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,tsx,jsx,json,vue}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
insert_final_newline = true

[*.sql]
charset = utf-8
indent_style = space
indent_size = 2

[*.yaml,*.yml]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
