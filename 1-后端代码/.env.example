#############################################
# 公路巡查系统 - .env.example（开发/生产模板）
# 将此文件复制为 1-后端代码/.env 并按需修改
# 注意：生产环境务必使用强随机 SECRET_KEY、关闭 DEBUG、仅允许白名单域
#############################################

# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=REDACTED_here
DATABASE_NAME=road_patrol_db

# 应用配置
DEBUG=True  # 开发：True；生产：False
SECRET_KEY=change_me_in_production_very_strong_secret
MAX_PAGE_SIZE=200

# JWT 配置
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

## 文件上传配置（相对路径将自动解析为后端目录下的绝对路径）
UPLOAD_FOLDER=photos
MAX_UPLOAD_SIZE=10485760

## CORS 配置（JSON 数组）
# 开发：配置本地前端域（如 http://localhost:3000）
# 生产：仅允许正式前端域（如 https://your-frontend.com）
# 留空将使用开发模式白名单；若使用 "*"，将自动关闭 allow_credentials
ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

## Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # 无密码留空，有密码填写

## Celery 任务队列配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Shanghai

