/* pages/patrol/list/list.wxss */

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 1px;
  height: 60rpx;
  background: var(--border-color);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
}

.filter-item {
  flex: 1;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.filter-item.active {
  background: linear-gradient(135deg, rgba(216, 180, 254, 0.15), rgba(192, 132, 252, 0.15));
  color: var(--accent-primary);
  font-weight: 600;
}

/* 记录列表 */
.record-list {
  padding-bottom: 140rpx;
}

.record-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.record-item:active {
  transform: scale(0.98);
}

/* 状态指示条 */
.status-indicator {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

/* 内容区 */
.record-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-left: 16rpx;
}

.record-header {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.record-type {
  font-size: 24rpx;
}

.record-status {
  font-size: 22rpx;
  background: transparent;
}

.record-desc {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.record-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.record-location .icon {
  font-size: 28rpx;
}

.location-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部信息 */
.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8rpx;
  border-top: 1px solid var(--border-color);
}

.severity {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.severity-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.severity-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 24rpx;
  color: var(--text-muted);
}

.star.active {
  color: #f59e0b;
}

.record-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 缩略图 */
.record-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.record-thumb image {
  width: 100%;
  height: 100%;
}

.photo-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(8rpx);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #d8b4fe, #c084fc);
  border-radius: 50%;
  box-shadow: 0 12rpx 32rpx rgba(192, 132, 252, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: all 0.3s ease;
}

.fab:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 72rpx;
  color: #1a0b2e;
  font-weight: 300;
  line-height: 1;
}

/* 加载更多提示 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
}
