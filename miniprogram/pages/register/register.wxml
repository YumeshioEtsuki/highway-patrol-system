<!-- pages/register/register.wxml -->
<view class="container">
  <view class="title">完善资料 / 注册</view>

  <form bindsubmit="onSubmit">
    <view class="form-item">
      <text class="label">用户名</text>
      <input name="username" placeholder="请输入用户名" class="input" />
    </view>

    <view class="form-item">
      <text class="label">真实姓名</text>
      <input name="real_name" placeholder="请输入真实姓名" class="input" />
    </view>

    <view class="form-item">
      <text class="label">手机号（可选）</text>
      <input name="phone" placeholder="请输入手机号" class="input" />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input name="password" placeholder="设置密码（至少8位，含字母和数字）" class="input" password="true" />
    </view>

    <button class="submit" formType="submit">提交注册并登录</button>
  </form>
</view>
