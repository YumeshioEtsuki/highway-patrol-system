<!-- pages/admin/detail/detail.wxml -->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 主内容 -->
  <view wx:else>
    <view class="status-banner" style="background: {{statusColor}}">
      <text class="status-text">{{statusText}}</text>
    </view>

    <view class="section card">
      <view class="section-header">
        <view class="section-title">问题信息</view>
        <view class="badge badge-primary">{{problemTypeText}}</view>
      </view>
      
      <view class="info-item" wx:if="{{record.description || record.problem_desc}}">
        <text class="info-label">问题描述</text>
        <text class="info-value">{{record.description || record.problem_desc}}</text>
      </view>

      <view class="info-item" wx:if="{{record.severity}}">
        <text class="info-label">严重程度</text>
        <view class="severity-display">
          <text class="star {{index < record.severity ? 'active' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">★</text>
        </view>
      </view>

      <view class="info-item" wx:if="{{record.segment_id}}">
        <text class="info-label">路段编号</text>
        <text class="info-value">{{record.segment_id}}</text>
      </view>

      <view class="info-item" wx:if="{{record.location_desc}}">
        <text class="info-label">位置</text>
        <text class="info-value">{{record.location_desc}}</text>
      </view>

      <view class="info-item" wx:if="{{record.latitude && record.longitude}}">
        <text class="info-label">GPS坐标</text>
        <text class="info-value">{{record.latitude}}, {{record.longitude}}</text>
      </view>

      <button class="btn btn-secondary" bindtap="openMap" wx:if="{{record.latitude && record.longitude}}">📍 在地图中查看</button>
    </view>

    <view class="section card" wx:if="{{photos.length > 0}}">
      <view class="section-title">现场照片 ({{photos.length}}张)</view>
      <view class="photo-grid">
        <image class="photo-item" wx:for="{{photos}}" wx:key="index" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-index="{{index}}"></image>
      </view>
    </view>

    <!-- 管理员操作区 -->
    <view class="section card" wx:if="{{record.status === 'pending' || record.status === 'processing'}}">
      <view class="section-title">🛠️ 处理操作</view>
      
      <view class="form-item">
        <view class="form-label">处理备注 <text class="required">*</text></view>
        <textarea 
          class="form-textarea" 
          placeholder="请填写处理意见和措施（必填）..." 
          value="{{remark}}" 
          bindinput="onRemarkInput" 
          maxlength="500"
          auto-height
        ></textarea>
        <view class="char-count">{{remark.length}}/500</view>
      </view>

      <view class="action-buttons">
        <button class="btn btn-warning flex-1" bindtap="handleProcessing" disabled="{{submitting}}" wx:if="{{record.status === 'pending'}}">
          ⏳ 标记处理中
        </button>
        <button class="btn btn-success flex-1" bindtap="handleComplete" disabled="{{submitting}}">
          ✅ 标记已完成
        </button>
      </view>
    </view>

    <!-- 处理记录 -->
    <view class="section card" wx:if="{{record.admin_remarks || record.admin_remark}}">
      <view class="section-title">📝 处理记录</view>
      <view class="info-item">
        <text class="info-label">管理员备注</text>
        <text class="info-value">{{record.admin_remarks || record.admin_remark}}</text>
      </view>
      <view class="info-item" wx:if="{{record.updated_at}}">
        <text class="info-label">处理时间</text>
        <text class="info-value">{{record.updated_at}}</text>
      </view>
    </view>

    <view class="action-section">
      <button class="btn btn-secondary" bindtap="goBack">返回列表</button>
    </view>
  </view>
</view>
