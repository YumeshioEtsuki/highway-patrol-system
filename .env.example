# 🔐 环境变量配置示例
# 复制此文件为 .env 并填写真实值（.env 文件不会被提交到 Git）

# ==================== 数据库配置 ====================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DB_PASSWORD=REDACTED_here  # 别名，等同于 DATABASE_PASSWORD
DATABASE_PASSWORD=REDACTED_here
DATABASE_NAME=road_patrol_db

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REDACTED

# ==================== JWT 认证 ====================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ==================== AI / 第三方密钥 ====================
DEEPSEEK_API_KEY=

# ==================== 应用配置 ====================
DEBUG=True
SECRET_KEY=your_secret_key_here

# === 安全/引导开关 ===
# 生产务必 SECURE_MODE=1，禁用 .env 读取，强制走系统环境变量
# BOOTSTRAP_ADMIN 仅限开发/初始化缺省管理员，用完改回 0
SECURE_MODE=0
BOOTSTRAP_ADMIN=0

# === 启动初始化控制 ===
# SKIP_DB_INIT 控制是否在应用启动时执行“数据库初始化/建表/引导检查”。
# - 0：执行初始化（如果数据库和表已存在，通常只是快速检查，不会破坏数据）
# - 1：跳过初始化（提升启动速度，更适合预发/生产）
# 建议：开发/测试=0，预发/生产=1
SKIP_DB_INIT=

# ==================== 测试账号（仅本地调试用，生产请禁用） ====================
TEST_BASE_URL=http://127.0.0.1:5000
TEST_ADMIN_USER=admin
TEST_ADMIN_PASSWORD=

# ==================== 管理员密码配置 ====================
# 开发/测试环境：直接指定admin密码
# 生产环境：留空让系统自动生成强密码，在启动日志中查看
DEFAULT_ADMIN_PASSWORD=

# ==================== 说明 ====================
# 1. 复制此文件: copy .env.example .env
# 2. 修改 .env 中的密码为真实密码
# 3. 永远不要提交 .env 文件到 Git！
# 4. 生产环境建议使用更安全的密钥管理方案（如 AWS Secrets Manager、Azure Key Vault）
