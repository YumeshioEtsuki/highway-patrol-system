<!-- pages/patrol/list/list.wxml -->
<view class="container">
  <!-- 顶部统计卡片 -->
  <view class="stats-card glass-card">
    <view class="stat-item">
      <text class="stat-number">{{totalCount}}</text>
      <text class="stat-label">总记录</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number text-warning">{{pendingCount}}</text>
      <text class="stat-label">待处理</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number text-success">{{completedCount}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 筛选器 -->
  <view class="filter-bar">
    <view class="filter-item {{filterStatus === '' ? 'active' : ''}}" bindtap="onFilterChange" data-status="">
      全部
    </view>
    <view class="filter-item {{filterStatus === 'pending' ? 'active' : ''}}" bindtap="onFilterChange" data-status="pending">
      待处理
    </view>
    <view class="filter-item {{filterStatus === 'processing' ? 'active' : ''}}" bindtap="onFilterChange" data-status="processing">
      处理中
    </view>
    <view class="filter-item {{filterStatus === 'completed' ? 'active' : ''}}" bindtap="onFilterChange" data-status="completed">
      已完成
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="record-list">
    <block wx:if="{{recordList.length > 0}}">
      <view class="record-item card" wx:for="{{recordList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <!-- 左侧状态指示条 -->
        <view class="status-indicator" style="background: {{item.statusColor}}"></view>

        <!-- 内容区 -->
        <view class="record-content">
          <!-- 头部 -->
          <view class="record-header">
            <view class="record-type badge badge-primary">
              {{item.problemTypeText}}
            </view>
            <view class="record-status badge" style="color: {{item.statusColor}}; border-color: {{item.statusColor}}">
              {{item.statusText}}
            </view>
          </view>

          <!-- 描述 -->
          <view class="record-desc">{{item.problem_desc}}</view>

          <!-- 位置 -->
          <view class="record-location">
            <text class="icon">📍</text>
            <text class="location-text">{{item.location_desc}}</text>
          </view>

          <!-- 底部信息 -->
          <view class="record-footer">
            <view class="severity">
              <text class="severity-label">严重程度：</text>
              <view class="severity-stars">
                <text class="star {{index < item.severity ? 'active' : ''}}" wx:for="{{5}}" wx:key="index">★</text>
              </view>
            </view>
            <view class="record-time">{{item.timeText}}</view>
          </view>
        </view>

        <!-- 缩略图 -->
        <view class="record-thumb" wx:if="{{item.thumbnail}}">
          <image src="{{item.thumbnail}}" mode="aspectFill"></image>
          <view class="photo-count" wx:if="{{item.photoCount > 1}}">
            <text>{{item.photoCount}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{recordList.length > 0}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{!hasMore}}">没有更多了</text>
      <text wx:else>上拉加载更多</text>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!loading && recordList.length === 0}}">
      <view class="empty-icon">📋</view>
      <view class="empty-text">暂无巡查记录</view>
      <button class="btn btn-primary mt-16" bindtap="goToCreate">创建第一条记录</button>
    </view>
  </view>

  <!-- 浮动创建按钮 -->
  <view class="fab" bindtap="goToCreate">
    <text class="fab-icon">+</text>
  </view>
</view>
