/* pages/admin/detail/detail.wxss */
@import "../../patrol/detail/detail.wxss";

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-muted);
  font-size: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #ef4444;
  margin-left: 4rpx;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.btn-warning {
  background: #f59e0b;
}

.btn-warning:active {
  background: #d97706;
}

.btn-success {
  background: #10b981;
}

.btn-success:active {
  background: #059669;
}
